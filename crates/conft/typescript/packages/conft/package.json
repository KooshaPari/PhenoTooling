{
  "name": "@phenotype/config-ts",
  "version": "0.1.0",
  "description": "TypeScript configuration management with Zod validation",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:requirements": "vitest run src/requirements-traceability.test.ts",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/package-smoke.mjs",
    "pack:check": "bun pm pack --dry-run",
    "check": "bun run lint && bun run typecheck && bun run test:coverage && bun run build && bun run smoke && bun run pack:check && bun run docs:build && bun audit --audit-level=high",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "config",
    "zod",
    "validation",
    "typescript",
    "hexagonal"
  ],
  "author": "Phenotype",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^8.55.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^4.1.10",
    "vitepress": "^1.6.3",
    "vue": "^3.5.13",
    "vitepress-plugin-mermaid": "^2.0.17",
    "mermaid": "^11.4.1",
    "@vitest/coverage-v8": "^4.1.10"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "vite": "6.4.3",
    "brace-expansion": "^1.1.18",
    "nanoid": "^3.3.16",
    "postcss": "^8.5.12",
    "js-yaml": "^4.3.0"
  }
}
