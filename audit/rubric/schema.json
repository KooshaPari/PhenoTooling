{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://phenotype.dev/schemas/scorecard-v3-unified.json",
  "title": "Phenotype Unified Audit Rubric v3",
  "type": "object",
  "required": [
    "id",
    "domain",
    "title",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[0-9]{3,5}$"
    },
    "domain": {
      "type": "string",
      "minLength": 2
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "enum": [
        "satisfied",
        "partial",
        "missing",
        "reference",
        "historical"
      ]
    },
    "evidence": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "weight": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 10
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}